IDD_OPTIONSDLG DIALOGEX 0, 0, 362, 431
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION
CAPTION "Options"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,127,410,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,183,410,50,14
    GROUPBOX        "Tile Cache Size",IDC_STATIC,7,7,348,54
    LTEXT           "The WMS Data Layer maintains a cache of recently used tiles. The tile cache size denotes the amount of memory that this cache may grow to.",IDC_STATIC,15,16,331,26
    CONTROL         "",IDC_CACHE_SLIDER,"msctls_trackbar32",WS_TABSTOP,46,33,264,15
    LTEXT           "16 MB",IDC_STATIC,45,47,20,8
    LTEXT           "256 MB",IDC_STATIC,292,47,24,8
    LTEXT           "128 MB",IDC_STATIC,175,47,24,8
    GROUPBOX        "Tile Load Order",IDC_STATIC,7,62,348,43
    LTEXT           "It is possible to configure the order in which the tiles are loaded.",IDC_STATIC,15,73,215,12
    COMBOBOX        IDC_TILELOADORDER,52,87,256,155,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "Pyramid Scale Factor",IDC_STATIC,7,182,348,83
    LTEXT           "The Pyramid Scale Factor determines the level at which the WMS data layer will switch to the next detail level (assuming tile levels are in use) or WMTS data layer will switch to the next tile matrix.",IDC_STATIC,15,193,332,19
    CONTROL         "",IDC_SCALE_FACTOR_SLIDER,"msctls_trackbar32",WS_TABSTOP,48,237,264,15
    LTEXT           "0.5",IDC_STATIC,50,251,12,8
    LTEXT           "2.0",IDC_STATIC,300,251,12,8
    LTEXT           "1.5",IDC_STATIC,217,251,12,8
    LTEXT           "1.0",IDC_STATIC,133,251,12,8
    LTEXT           "A value of 1.0 means that the tile will, at most, only be displayed at its native resolution or smaller. A value of 2.0 means that the tile maybe displayed at up to twice its native resolution etc.",IDC_STATIC,15,215,332,21
    GROUPBOX        "WMS SAML V2.0 ECP Options",IDC_STATIC,7,269,348,42
    CONTROL         "Allow SSL certificates to be issued by an unknown authority",IDC_UNKNOWN_CA,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,281,206,10
    CONTROL         "Allow SSL certificates to not correspond with the respondents domain name.",IDC_CERT_CN_INVALID,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,294,259,10
    GROUPBOX        "WMS Tile Levels",IDC_STATIC,7,108,348,69
    LTEXT           "By using tile levels the number of tiles requested from the server are reduced through scaling tiles beyond their native zoom scale. This can however distort images that were created from vector data.",IDC_STATIC,15,119,331,19
    LTEXT           "It is also possible to determine whether tile levels are appropriate based upon whether the server advertises that the source of the data is vector or raster.",IDC_STATIC,15,141,331,19
    COMBOBOX        IDC_TILELEVELS,85,160,190,52,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "Initial WMS Version Requested",IDC_STATIC,7,315,348,51
    COMBOBOX        IDC_INITIALWMSVERSION,85,348,190,71,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "This allows the User to override the WMS version that the WMSDataLayer initially requests to start the version negotiation with the remote server.",IDC_STATIC,15,326,331,20
    GROUPBOX        "Number of Concurrent Requests",IDC_STATIC,7,370,348,36
    EDITTEXT        IDC_NUMBER_OF_THREADS,122,384,53,14,ES_AUTOHSCROLL
    LTEXT           "Number of Concurrent requests",IDC_STATIC,15,386,104,8
    LTEXT           "The number is limited by this sample to a maximum of 32 concurrent requests. The response time will be dependent upon the Server load.",IDC_STATIC,184,378,164,27
END


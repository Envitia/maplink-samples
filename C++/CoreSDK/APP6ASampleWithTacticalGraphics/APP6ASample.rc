            MENUITEM "Selector",                    ID_APP6A_SELECTOR
            MENUITEM SEPARATOR
            MENUITEM "Declutter Options",           ID_APP6A_DECLUTTEROPTIONS
        END
    END
    POPUP "Co&nstraint"
    BEGIN
        MENUITEM "Equal",                       ID_CONSTRAINT_EQUAL
        MENUITEM "Unequal",                     ID_CONSTRAINT_UNEQUAL
        MENUITEM "Vertical",                    ID_CONSTRAINT_VERTICAL
        MENUITEM "Horizontal",                  ID_CONSTRAINT_HORIZONTAL
        MENUITEM "Angular",                     ID_CONSTRAINT_ANGULAR
        MENUITEM "Distance",                    ID_CONSTRAINT_DISTANCE
    END
    POPUP "&Primitives"

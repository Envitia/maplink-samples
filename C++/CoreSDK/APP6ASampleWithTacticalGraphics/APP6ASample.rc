        MENUITEM "Text",                        ID_PRIMITIVES_TEXT
        MENUITEM "Change Text",                 ID_PRIMITIVES_CHANGETEXT
    END
    POPUP "Tactical Graphics"
    BEGIN
        POPUP "Axis"
        BEGIN
            MENUITEM "Friendly Main Attack",        ID_FRIENDY_GROUNDMAINAXIS
            MENUITEM "Friendly Supporting Attack",  ID_AXIS_FRIENDLYGROUNDSUPPORTINGATTACK
            MENUITEM "Friendly Planned Attack",     ID_AXIS_FRIENDLYPLANNEDATTACK
            MENUITEM "Friendly Feint",              ID_AXIS_FEINT
            MENUITEM "Counter Attack",              ID_AXIS_COUNTERATTACK
            MENUITEM "Enemy Confirmed",             ID_AXIS_ENEMYCONFIRMED
            MENUITEM "Enemy Suspected",             ID_AXIS_ENEMYSUSPECTED
        END
        POPUP "Direction"
        BEGIN
            MENUITEM "Friendly Main Attack",        ID_DIRECTION_FRIENDLYMAINATTACK
            MENUITEM "Friendly Supporting Attack",  ID_DIRECTION_FRIENDLYSUPPORTINGATTACK
            MENUITEM "Friendly Planned Attack",     ID_DIRECTION_FRIENDLYPLANNEDATTACK
            MENUITEM "Friendly Feint",              ID_DIRECTION_ATTACKFORFEINT
        END
        POPUP "3/4 Point Attacks"
        BEGIN
            MENUITEM "Attack by Fire Position",     ID_3POINTATTACKS_ATTACKBYFIREPOSITION
            MENUITEM "Support by Fire Position",    ID_3_SUPPORTBYFIREPOSITION
            MENUITEM "Surprise Attack",             ID_3POINTATTACKS_SURPRISEATTACK
        END
        POPUP "Follow"
        BEGIN
            MENUITEM "Follow and Assume",           ID_FOLLOW_FOLLOWANDASSUME
            MENUITEM "Follow and Support",          ID_FOLLOW_FOLLOWANDSUPPORT
        END
        MENUITEM "Contain",                     ID_TACTICALGRAPHICS_CONTAIN
        MENUITEM "Disrupt",                     ID_TACTICALGRAPHICS_DISRUPT, GRAYED
        MENUITEM "Block",                       ID_TACTICALGRAPHICS_BLOCK
        POPUP "Bypass"
        BEGIN

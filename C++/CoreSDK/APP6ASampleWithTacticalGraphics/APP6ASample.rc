        MENUITEM SEPARATOR
        MENUITEM "Group",                       ID_TRANSFORMATION_GROUP
        MENUITEM "Ungroup  ",                   ID_TRANSFORMATION_UNGROUP
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About APP6A Sample...",      ID_APP_ABOUT
    END
END



            MENUITEM "Bypass Difficult",            ID_BYPASS_BYPASSDIFFICULT
            MENUITEM "Bypass Impossible",           ID_BYPASS_BYPASSIMPOSSIBLE
        END
        POPUP "Convoy"
        BEGIN
            MENUITEM "Moving",                      ID_CONVOY_MOVING
            MENUITEM "Halted",                      ID_CONVOY_HALTED
        END
    END
    POPUP "T&ransformation"
    BEGIN
        MENUITEM "Move",                        ID_TRANSFORMATION_MOVE
        MENUITEM "Scale",                       ID_TRANSFORMATION_SCALE
        MENUITEM "Rotate",                      ID_TRANSFORMATION_ROTATE

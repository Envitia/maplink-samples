            MENUITEM "Set 2",                       ID_SAVEDVIEWS_SET2
            MENUITEM "Set 3",                       ID_SAVEDVIEWS_SET3
            MENUITEM SEPARATOR
            MENUITEM "Reset",                       ID_SAVEDVIEWS_RESET
        END
        POPUP "View Stack"
        BEGIN
            MENUITEM "Previous View",               ID_VIEWSTACK_PREVIOUSVIEW

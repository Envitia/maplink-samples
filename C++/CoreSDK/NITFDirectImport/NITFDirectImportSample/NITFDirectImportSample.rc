        BEGIN
            MENUITEM "Goto 1",                      ID_SAVEDVIEWS_GOTO1
            MENUITEM "Goto 2",                      ID_SAVEDVIEWS_GOTO2
            MENUITEM "Goto 3",                      ID_SAVEDVIEWS_GOTO3

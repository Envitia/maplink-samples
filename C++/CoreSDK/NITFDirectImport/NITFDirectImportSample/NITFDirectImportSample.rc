        MENUITEM "Metadata Info",               ID_VIEW_METADATAINFO
        MENUITEM "Display Item Settings Before Process", ID_VIEW_DISPLAYITEMSETTINGSBEFOREPROCESS
    END
    POPUP "&Tools"
    BEGIN
        MENUITEM "Zoom &In",                    ID_TOOLS_ZOOMIN
        MENUITEM "Zoom &Out",                   ID_TOOLS_ZOOMOUT
        MENUITEM "&Reset",                      ID_TOOLS_RESET

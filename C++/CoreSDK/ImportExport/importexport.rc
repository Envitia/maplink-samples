/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON                    "res\\importexport.ico"
IDR_MFCTYPE             ICON                    "res\\importexportDoc.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Bitmap
//

IDR_MAINFRAME           BITMAP                  "res\\Toolbar.bmp"

/////////////////////////////////////////////////////////////////////////////
//
// Toolbar
//

IDR_MAINFRAME TOOLBAR  16, 16
BEGIN
    BUTTON      ID_FILE_OPEN
    BUTTON      ID_FILE_APPEND
    BUTTON      ID_FILE_SAVE
    SEPARATOR
    BUTTON      ID_FILE_PRINT
    SEPARATOR
    BUTTON      ID_EDIT_COPY
    SEPARATOR
    BUTTON      ID_TOOLS_ZOOMIN
    BUTTON      ID_TOOLS_ZOOMOUT
    BUTTON      ID_TOOLS_RESET
    SEPARATOR
    BUTTON      ID_TOOLS_ZOOM
    BUTTON      ID_TOOLS_PAN
    BUTTON      ID_TOOLS_ZOOMPAN
    BUTTON      ID_TOOLS_GRAB
    SEPARATOR
    BUTTON      ID_TOOLS_VIEW_ATTS
    SEPARATOR
    BUTTON      ID_APP_ABOUT
END


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Import...\tCtrl+I",          ID_FILE_OPEN
        MENUITEM "Append...\tCtrl+A",           ID_FILE_APPEND
        POPUP "&Export\tCtrl+E"
        BEGIN
            MENUITEM "&Shapefile",                  ID_FILE_EXPORT_SHAPEFILE
            MENUITEM "&ASCII",                      ID_FILE_EXPORT_ASCII
            MENUITEM "&TMF",                        ID_FILE_EXPORT_TMF
            MENUITEM "&MIF",                        ID_FILE_EXPORT_MIF
            MENUITEM "&OSMasterMap",                ID_FILE_EXPORT_OSM
            MENUITEM "S&57",                        ID_EXPORT_S57
        END
        MENUITEM SEPARATOR
        MENUITEM "&Print...\tCtrl+P",           ID_FILE_PRINT
        MENUITEM "Print Pre&view",              ID_FILE_PRINT_PREVIEW
        MENUITEM "P&rint Setup...",             ID_FILE_PRINT_SETUP
        MENUITEM SEPARATOR
        MENUITEM "Recent File",                 ID_FILE_MRU_FILE1, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Copy\tCtrl+C",               ID_EDIT_COPY
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
    END
    POPUP "&Tools"
    BEGIN
        MENUITEM "Zoom &In",                    ID_TOOLS_ZOOMIN
        MENUITEM "Zoom &Out",                   ID_TOOLS_ZOOMOUT
        MENUITEM "&Reset",                      ID_TOOLS_RESET
        MENUITEM SEPARATOR
        MENUITEM "Zoom",                        ID_TOOLS_ZOOM
        MENUITEM "Pan",                         ID_TOOLS_PAN
        MENUITEM "Zoom/Pan",                    ID_TOOLS_ZOOMPAN
        MENUITEM "&Grab",                       ID_TOOLS_GRAB
        MENUITEM SEPARATOR
        MENUITEM "&View Attributes",            ID_TOOLS_VIEW_ATTS
    END
    POPUP "Test Configuration"
    BEGIN
        MENUITEM "1: Default",                  ID_TEST_DEFAULT
        MENUITEM "2: Native Rendering Off",     ID_TEST_NATIVE_RENDERING
        MENUITEM "3: Geometrical Grouping",     ID_TEST_GEOM_GROUPING
        MENUITEM "4: Attribute Grouping",       ID_TEST_ATTRIBUTE_GROUPING
        MENUITEM "5: Geometrical and Attribute Grouping", 
                                                ID_TEST_GEOM_ATTRIB_GROUPING
        MENUITEM "6: Entity Exclusion",         ID_TEST_ENTITY_EXCLUSION
        MENUITEM "7: Attribute Exclusion",      ID_TEST_ATTRIB_EXCLUSION
        MENUITEM "8: Attribute Type Exclusion", ID_TEST_ATTRIB_TYPE_EXCLUSION

        MENUITEM "9: External Attributes",      ID_TEST_EXTERNAL_ATTRIB
        MENUITEM "10: Attribute Renaming",      ID_TEST_ATTRIB_RENAMING
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About importexport...",      ID_APP_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDR_MAINFRAME ACCELERATORS 
BEGIN
    "C",            ID_EDIT_COPY,           VIRTKEY, CONTROL, NOINVERT
    "N",            ID_FILE_NEW,            VIRTKEY, CONTROL, NOINVERT
    "O",            ID_FILE_OPEN,           VIRTKEY, CONTROL, NOINVERT
    "P",            ID_FILE_PRINT,          VIRTKEY, CONTROL, NOINVERT
    "V",            ID_EDIT_PASTE,          VIRTKEY, CONTROL, NOINVERT
    VK_ADD,         ID_TOOLS_ZOOMIN,        VIRTKEY, NOINVERT
    VK_BACK,        ID_EDIT_UNDO,           VIRTKEY, ALT, NOINVERT
    VK_DELETE,      ID_EDIT_CUT,            VIRTKEY, SHIFT, NOINVERT
    VK_F6,          ID_NEXT_PANE,           VIRTKEY, NOINVERT
    VK_F6,          ID_PREV_PANE,           VIRTKEY, SHIFT, NOINVERT
    VK_INSERT,      ID_EDIT_COPY,           VIRTKEY, CONTROL, NOINVERT
    VK_INSERT,      ID_EDIT_PASTE,          VIRTKEY, SHIFT, NOINVERT
    VK_SUBTRACT,    ID_TOOLS_ZOOMOUT,       VIRTKEY, NOINVERT
    "X",            ID_EDIT_CUT,            VIRTKEY, CONTROL, NOINVERT
    "Z",            ID_EDIT_UNDO,           VIRTKEY, CONTROL, NOINVERT
END



 FILEVERSION 11,3,3,0
 PRODUCTVERSION 11,3,3,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "MapLink Application 11.3"
            VALUE "FileVersion", "11.3.3.0"
            VALUE "InternalName", "importexport"
            VALUE "LegalCopyright", "Copyright © 1998-2026 Envitia Group PLC. All rights reserved."
            VALUE "OriginalFilename", "importexport.EXE"
            VALUE "ProductName", "MapLink Application"
            VALUE "ProductVersion", "11.3.3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END



IDD_ABOUTBOX DIALOG  0, 0, 217, 55
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About importexport"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           "importexport Version 1.0",IDC_STATIC,40,10,119,8,
                    SS_NOPREFIX
    LTEXT           "Copyright © 1998-2025 Envitia Group PLC. All rights reserved.\nPortions of this product were created using LEADTOOLS © 1991-2025\nLEAD Technologies, Inc.  ALL RIGHTS RESERVED.",
                    IDC_STATIC,40,25,150,24
    DEFPUSHBUTTON   "OK",IDOK,178,7,32,14,WS_GROUP
END



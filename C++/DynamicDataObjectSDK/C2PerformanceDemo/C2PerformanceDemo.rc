IDD_ABOUTBOX DIALOGEX 0, 0, 257, 90
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About C2PerformanceDemo"
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
    LTEXT           "C2PerformanceDemo Version 1.0",IDC_APP,7,42,212,9,SS_NOPREFIX
    CTEXT           "Portions developed using LEADTOOLS,\nCopyright © 1991-2025 LEAD Technologies, Inc. ALL RIGHTS RESERVED",IDC_THIRDPARTY,7,65,243,17
    DEFPUSHBUTTON   "OK",IDOK,205,7,45,14,WS_GROUP
    CONTROL         "",IDC_LOGO,"Static",SS_OWNERDRAW,8,9,136,25
    LTEXT           "Copyright © 1998-2026 Envitia Group PLC. All rights reserved.",IDC_COPYRIGHT,7,51,215,8
END

IDD_TRACK_INFO DIALOGEX 0, 0, 164, 211
STYLE DS_SETFONT | WS_CHILD
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    PUSHBUTTON      "&Apply",IDC_APPLY,19,180,55,15,WS_DISABLED
    PUSHBUTTON      "&Reset",IDC_RESET,89,180,55,15,WS_DISABLED
    LTEXT           "Latitude :",IDC_STATIC,31,135,30,10,0,WS_EX_RIGHT
    LTEXT           "Longitude :",IDC_STATIC,27,155,35,10,0,WS_EX_RIGHT
    LTEXT           "",IDC_LATITUDE,66,135,80,12,0,WS_EX_STATICEDGE
    LTEXT           "",IDC_LONGTITUDE,66,155,80,12,0,WS_EX_STATICEDGE
    COMBOBOX        IDC_HOSTILITY_COMBO,65,115,80,52,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Hostility :",IDC_STATIC,31,115,30,10,0,WS_EX_RIGHT
    LTEXT           "Heading :",IDC_STATIC,27,37,34,10,0,WS_EX_RIGHT
    LTEXT           "Velocity :",IDC_STATIC,31,57,30,10,0,WS_EX_RIGHT
    LTEXT           "Altitude :",IDC_STATIC,31,77,30,10,0,WS_EX_RIGHT
    LTEXT           "Track Number :",IDC_STATIC,11,15,50,10,0,WS_EX_RIGHT
    LTEXT           "",IDC_TRACK_NUMBER,66,15,40,12,0,WS_EX_STATICEDGE
    EDITTEXT        IDC_HEADING,66,35,40,12,ES_AUTOHSCROLL
    EDITTEXT        IDC_VELOCITY,66,55,40,12,ES_AUTOHSCROLL
    EDITTEXT        IDC_ALTITUDE,66,75,40,12,ES_AUTOHSCROLL
    LTEXT           "Knots",IDC_STATIC,110,57,26,11
    LTEXT           "Feet",IDC_STATIC,110,77,26,11
    COMBOBOX        IDC_TRACKTYPE_COMBO,65,95,80,52,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Track Type :",IDC_STATIC,10,95,51,10,0,WS_EX_RIGHT
END

IDD_NO_OF_TRACKS DIALOGEX 0, 0, 186, 47
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Set the number of tracks"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_NO_TRACKS,86,7,93,14,ES_AUTOHSCROLL | ES_NUMBER
    DEFPUSHBUTTON   "OK",IDOK,38,26,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,96,26,50,14
    LTEXT           "Number of tracks:",IDC_STATIC,7,9,78,9
END



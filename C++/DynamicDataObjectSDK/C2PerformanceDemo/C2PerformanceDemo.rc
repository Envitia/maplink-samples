/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open...\tCtrl+O",            ID_FILE_OPEN
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR, CHECKED
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR, CHECKED
        MENUITEM SEPARATOR
        MENUITEM "&Range Rings",                ID_VIEW_RANGERINGS, CHECKED
        MENUITEM "Lat/Lon Grid",                ID_VIEW_LAT
    END
    POPUP "&Tools"
    BEGIN
        MENUITEM "Zoom &In",                    ID_TOOLS_ZOOMIN
        MENUITEM "Zoom &Out",                   ID_TOOLS_ZOOMOUT
        MENUITEM "&Reset",                      ID_TOOLS_RESET
        MENUITEM SEPARATOR
        MENUITEM "&Zoom",                       ID_TOOLS_ZOOM
        MENUITEM "&Pan",                        ID_TOOLS_PAN
        MENUITEM "&Grab",                       ID_TOOLS_GRAB
        MENUITEM "Track &Select",               ID_TOOLS_TRACKSELECT
        MENUITEM SEPARATOR
        MENUITEM "&Follow Selected",            ID_TOOLS_FOLLOWSELECTED
        MENUITEM "&North Up",                   ID_TOOLS_NORTHUP
        MENUITEM "&Track Heading Up",           ID_TOOLS_TRACKHEADINGUP
    END
    POPUP "&Range"
    BEGIN
        MENUITEM "500 km",                      ID_RANGE_500KM
        MENUITEM "200 km",                      ID_RANGE_200KM
        MENUITEM "100 km",                      ID_RANGE_100KM
        MENUITEM "50 km",                       ID_RANGE_50KM
        MENUITEM "10 km",                       ID_RANGE_10KM
    END
    POPUP "&Simulation"
    BEGIN
        MENUITEM "Real Time",                   ID_SIMULATION_REALTIME, CHECKED
        MENUITEM "x 2 Speed",                   ID_SIMULATION_2SPEED
        MENUITEM "x 5 Speed",                   ID_SIMULATION_5SPEED
        MENUITEM "x 10 Speed",                  ID_SIMULATION_10SPEED
        MENUITEM "x 50 Speed",                  ID_SIMULATION_50SPEED
    END
    POPUP "S&ymbols"
    BEGIN
        MENUITEM "Standard",                    ID_SYMBOLS_STANDARD, CHECKED
        MENUITEM "APP6A",                       ID_SYMBOLS_APP6A
        MENUITEM "2525B",                       ID_SYMBOLS_2525B
        MENUITEM SEPARATOR
        MENUITEM "Number of Tracks",            ID_SYMBOLS_CHANGETHENUMBEROFTRACKS
        MENUITEM SEPARATOR
        POPUP "APP6A/2525B Annotation Level"
        BEGIN
            MENUITEM "None",                        ID_APP6AANNOTATIONLEVEL_NONE, CHECKED
            MENUITEM "Low",                         ID_APP6AANNOTATIONLEVEL_LOW
            MENUITEM "Medium",                      ID_APP6AANNOTATIONLEVEL_MEDIUM
            MENUITEM "High",                        ID_APP6AANNOTATIONLEVEL_HIGH
        END
        POPUP "APP6A/2525B Rendering"
        BEGIN
            MENUITEM "Bitmap-based",                ID_APP6ARENDERING_BITMAP
            MENUITEM "Entity-based",                ID_APP6ARENDERING_ENTITY
        END
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Contents",                   ID_APP_HELP
        MENUITEM SEPARATOR
        MENUITEM "&Contact Envitia",            ID_HELP_CONTACT
        MENUITEM SEPARATOR
        MENUITEM "&About C2PerformanceDemo...", ID_APP_ABOUT
    END
END



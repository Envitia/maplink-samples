IDD_FEATURE_CONFIG DIALOGEX 0, 0, 305, 141
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Vector Feature Configuration"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    PUSHBUTTON      "Load...",IDC_LOAD_FCC,181,120,50,14
    PUSHBUTTON      "Custom",IDC_CUSTOM_FCC,113,120,50,14
    PUSHBUTTON      "Generate",IDC_GENERATE_FCC,45,120,50,14
    LTEXT           "NOTE: Some pre-defined styling, such as OpenStreetMap, depend upon an output CRS that in metres not degrees. The app will swap to EPSG:3395 if it detects an OpenStreetMap file being loaded.",IDC_STATIC,7,91,291,25
    CONTROL         "Please select 'Generate' to apply high-level basic styling.\n\nPlease select 'Custom' to apply custom OpenStreetMap styling.\n    Compatible sample OpenStreetMap data is supplied with MapLink Pro\n\nPlease select 'Load...' to select a pre-defined configuration from a file.",IDC_STATIC,
                    "Static",SS_LEFTNOWORDWRAP | WS_GROUP,35,30,249,51
    LTEXT           "Vector data requires a Feature Configuration to supply classification, masking and rendering parameters.",IDC_STATIC,7,7,291,17
END



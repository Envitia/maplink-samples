    BUTTON      ID_SAVEDVIEWS_GOTO2
    BUTTON      ID_SAVEDVIEWS_GOTO3
END


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open...\tCtrl+O",            ID_FILE_OPEN
        MENUITEM SEPARATOR
        MENUITEM "&Print...\tCtrl+P",           ID_FILE_PRINT
        MENUITEM "Print Pre&view",              ID_FILE_PRINT_PREVIEW
        MENUITEM "P&rint Setup...",             ID_FILE_PRINT_SETUP
        MENUITEM SEPARATOR
        MENUITEM "Recent File",                 ID_FILE_MRU_FILE1
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Copy\tCtrl+C",               ID_EDIT_COPY
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
    END
    POPUP "&Tools"
    BEGIN
        MENUITEM "Zoom &In",                    ID_TOOLS_ZOOMIN
        MENUITEM "Zoom &Out",                   ID_TOOLS_ZOOMOUT
        MENUITEM "&Reset",                      ID_TOOLS_RESET
        MENUITEM SEPARATOR
        MENUITEM "&Zoom",                       ID_TOOLS_ZOOM
        MENUITEM "&Pan",                        ID_TOOLS_PAN
        MENUITEM "&Grab",                       ID_TOOLS_GRAB
        MENUITEM "&Magnify",                    ID_TOOLS_MAGNIFY
        MENUITEM SEPARATOR
        POPUP "Saved Views"
        BEGIN
            MENUITEM "Goto 1",                      ID_SAVEDVIEWS_GOTO1
            MENUITEM "Goto 2",                      ID_SAVEDVIEWS_GOTO2
            MENUITEM "Goto 3",                      ID_SAVEDVIEWS_GOTO3
            MENUITEM SEPARATOR
            MENUITEM "Set 1",                       ID_SAVEDVIEWS_SET1
            MENUITEM "Set 2",                       ID_SAVEDVIEWS_SET2
            MENUITEM "Set 3",                       ID_SAVEDVIEWS_SET3
            MENUITEM SEPARATOR
            MENUITEM "Reset",                       ID_SAVEDVIEWS_RESET
        END
        POPUP "View Stack"
        BEGIN
            MENUITEM "Previous View",               ID_VIEWSTACK_PREVIOUSVIEW
            MENUITEM "Next View",                   ID_VIEWSTACK_NEXTVIEW
        END
    END
    POPUP "CRS"
    BEGIN
        MENUITEM "Default Input to EPSG:27700", ID_CRS_DEFAULT_TO_27700
        MENUITEM "Default Input to EPSG:4326",  ID_CRS_DEFAULT_TO_4326
        MENUITEM SEPARATOR
        MENUITEM "Display using data CRS",      ID_CRS_DISPLAY_USING_DATA_CRS
        MENUITEM "Display using EPSG:4326",     ID_CRS_DISPLAY_USING_4326
        MENUITEM "Display using EPSG:27700",    ID_CRS_DISPLAY_USING_27700
        MENUITEM "Display using EPSG:3395",     ID_CRS_DISPLAY_USING_3395
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About DirectImportSimpleViewer...", ID_APP_ABOUT
    END
END



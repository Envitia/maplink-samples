/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open Map...\tCtrl+O",        ID_FILE_OPEN
        MENUITEM "Open Terrain...",             ID_FILE_OPENTERRAIN
        MENUITEM SEPARATOR
        MENUITEM "Open CADRG...",               ID_FILE_CADRG
        MENUITEM "Open WMS...",                 ID_FILE_WMS
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
        MENUITEM SEPARATOR
        MENUITEM "CADRG on Top",                ID_VIEW_CADRGONTOP
        MENUITEM "WMS on Top",                  ID_VIEW_WMSONTOP
        MENUITEM SEPARATOR
        MENUITEM "CADRG Transparent",           ID_VIEW_CADRGTRANSPARENT
        MENUITEM "WMS Transparent",             ID_VIEW_WMSTRANSPARENT
    END
    POPUP "&Tools"
    BEGIN
        MENUITEM "Zoom &In",                    ID_TOOLS_ZOOMIN
        MENUITEM "Zoom &Out",                   ID_TOOLS_ZOOMOUT
        MENUITEM "&Reset",                      ID_TOOLS_RESET
        MENUITEM SEPARATOR
        MENUITEM "Trackball &Eyepoint Style",   ID_TOOLS_TRACKBALLEYEPOINT
        MENUITEM "Trackball &World Style",      ID_TOOLS_TRACKBALLWORLD
        MENUITEM SEPARATOR
        POPUP "Saved Views"
        BEGIN
            MENUITEM "Goto 1",                      ID_SAVEDVIEWS_GOTO1
            MENUITEM "Goto 2",                      ID_SAVEDVIEWS_GOTO2
            MENUITEM "Goto 3",                      ID_SAVEDVIEWS_GOTO3
            MENUITEM SEPARATOR
            MENUITEM "Set 1",                       ID_SAVEDVIEWS_SET1
            MENUITEM "Set 2",                       ID_SAVEDVIEWS_SET2
            MENUITEM "Set 3",                       ID_SAVEDVIEWS_SET3
            MENUITEM SEPARATOR
            MENUITEM "Reset",                       ID_SAVEDVIEWS_RESET
        END
        POPUP "View Stack"
        BEGIN
            MENUITEM "Previous View",               ID_VIEWSTACK_PREVIOUSVIEW
            MENUITEM "Next View",                   ID_VIEWSTACK_NEXTVIEW
        END
        MENUITEM SEPARATOR
        MENUITEM "Create Polygon",              32815
        MENUITEM SEPARATOR
        MENUITEM "Exaggerate Terrain",          ID_TOOLS_EXAGGERATETERRAIN
        MENUITEM "Wireframe",                   ID_TOOLS_WIREFRAME
        MENUITEM SEPARATOR
        MENUITEM "Limit Camera",                ID_TOOLS_LIMITCAMERA
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Simple3DDirectImport...", ID_APP_ABOUT
    END
END



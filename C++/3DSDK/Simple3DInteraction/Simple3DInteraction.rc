/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON                    "res\\Simple3DInteraction.ico"
IDR_SIMPLE3DINTERACTIONTYPE ICON                    "res\\Simple3DInteractionDoc.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Bitmap
//

IDR_MAINFRAME           BITMAP                  "res\\Toolbar.bmp"

/////////////////////////////////////////////////////////////////////////////
//
// Toolbar
//

IDR_MAINFRAME TOOLBAR  24, 24
BEGIN
    BUTTON      ID_FILE_OPEN
    SEPARATOR
    BUTTON      ID_TOOLS_ZOOMIN
    BUTTON      ID_TOOLS_ZOOMOUT
    BUTTON      ID_TOOLS_RESET
    SEPARATOR
    BUTTON      ID_TOOLS_TRACKBALLEYEPOINT
    BUTTON      ID_TOOLS_TRACKBALLWORLD
    SEPARATOR
    BUTTON      ID_VIEWSTACK_PREVIOUSVIEW
    BUTTON      ID_VIEWSTACK_NEXTVIEW
    SEPARATOR
    BUTTON      ID_SAVEDVIEWS_GOTO1
    BUTTON      ID_SAVEDVIEWS_GOTO2
    BUTTON      ID_SAVEDVIEWS_GOTO3
END


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open...\tCtrl+O",            ID_FILE_OPEN
        MENUITEM "Open Terrain",                ID_FILE_OPENTERRAIN
        MENUITEM SEPARATOR
        MENUITEM "Recent File",                 ID_FILE_MRU_FILE1, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
    END
    POPUP "&Tools"
    BEGIN
        MENUITEM "Zoom &In",                    ID_TOOLS_ZOOMIN
        MENUITEM "Zoom &Out",                   ID_TOOLS_ZOOMOUT
        MENUITEM "&Reset",                      ID_TOOLS_RESET
        MENUITEM SEPARATOR
        MENUITEM "Trackball &Eyepoint Style",   ID_TOOLS_TRACKBALLEYEPOINT
        MENUITEM "Trackball &World Style",      ID_TOOLS_TRACKBALLWORLD
        MENUITEM SEPARATOR
        POPUP "Saved Views"
        BEGIN
            MENUITEM "Goto 1",                      ID_SAVEDVIEWS_GOTO1
            MENUITEM "Goto 2",                      ID_SAVEDVIEWS_GOTO2
            MENUITEM "Goto 3",                      ID_SAVEDVIEWS_GOTO3
            MENUITEM SEPARATOR
            MENUITEM "Set 1",                       ID_SAVEDVIEWS_SET1
            MENUITEM "Set 2",                       ID_SAVEDVIEWS_SET2
            MENUITEM "Set 3",                       ID_SAVEDVIEWS_SET3
            MENUITEM SEPARATOR
            MENUITEM "Reset",                       ID_SAVEDVIEWS_RESET
        END
        POPUP "View Stack"
        BEGIN
            MENUITEM "Previous View",               ID_VIEWSTACK_PREVIOUSVIEW
            MENUITEM "Next View",                   ID_VIEWSTACK_NEXTVIEW
        END
        MENUITEM SEPARATOR
        MENUITEM "Create Polygon",              32815
        MENUITEM SEPARATOR
        MENUITEM "Exaggerate Terrain",          ID_TOOLS_EXAGGERATETERRAIN
        MENUITEM "Wireframe",                   ID_TOOLS_WIREFRAME
        MENUITEM SEPARATOR
        MENUITEM "Limit Camera",                ID_TOOLS_LIMITCAMERA
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Simple3DInteraction...", ID_APP_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDR_MAINFRAME ACCELERATORS 
BEGIN
    "O",            ID_FILE_OPEN,           VIRTKEY, CONTROL, NOINVERT
    VK_F6,          ID_NEXT_PANE,           VIRTKEY, NOINVERT
    VK_F6,          ID_PREV_PANE,           VIRTKEY, SHIFT, NOINVERT
    VK_ADD,         ID_TOOLS_ZOOMIN,        VIRTKEY, NOINVERT
    VK_SUBTRACT,    ID_TOOLS_ZOOMOUT,       VIRTKEY, NOINVERT
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 257, 90
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Simple3DInteraction"
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
    LTEXT           "Simple3DInteraction Version 1.0",IDC_APP,7,42,212,9,SS_NOPREFIX
    CTEXT           "Portions developed using LEADTOOLS,\nCopyright © 1991-2025 LEAD Technologies, Inc. ALL RIGHTS RESERVED",IDC_THIRDPARTY,7,65,243,17
    DEFPUSHBUTTON   "OK",IDOK,205,7,45,14,WS_GROUP
    CONTROL         "",IDC_LOGO,"Static",SS_OWNERDRAW,8,9,136,25
    LTEXT           "Copyright © 1998-2026 Envitia Group PLC. All rights reserved.",IDC_COPYRIGHT,7,51,215,8
END


/////////////////////////////////////////////////////////////////////////////
//
// Version
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 11,3,3,0
 PRODUCTVERSION 11,3,3,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Envitia Group PLC"
            VALUE "FileDescription", "Envitia Simple Interaction Sample Application 11.3"
            VALUE "FileVersion", "11.3.3.0"
            VALUE "InternalName", "Simple3DInteraction"
            VALUE "LegalCopyright", "Copyright © 1998-2026 Envitia Group PLC. All rights reserved."
            VALUE "OriginalFilename", "Simple3DInteraction.EXE"
            VALUE "ProductName", "Simple Interaction Sample Application"
            VALUE "ProductVersion", "11.3.3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END


